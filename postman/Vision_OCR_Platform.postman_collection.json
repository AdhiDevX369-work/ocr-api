              "script": {
                "exec": [
                  "if (pm.response.code === 202) {",
                  "    var json = pm.response.json();",
                  "    if (json.batch_id) {",
                  "        pm.collectionVariables.set('batchId', json.batch_id);",
                  "        pm.environment.set('batchId', json.batch_id);",
                  "        console.log('Saved batchId: ' + json.batch_id);",
                  "    }",
